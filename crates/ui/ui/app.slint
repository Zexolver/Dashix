import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox } from "std-widgets.slint";

export struct InterfaceInfo {
    name: string,
    mac: string,
    ipv4: string,
    ipv6: string,
}

export struct RouteRow {
    id: string,
    subdomain: string,
    is-static: bool,
    path: string,
    port: int,
    tls: bool,
    internal-port: int,
}

export struct L4RuleRow {
    id: string,
    name: string,
    is-udp: bool,
    listen-port: int,
    upstream-port: int,
}

export struct MailAccountRow {
    address: string,
    display-name: string,
}

export global AppState {
    in-out property <string> status-line: "";

    // On Android 12+ this gets overwritten at startup with the device's
    // Material You wallpaper-derived accent color (see
    // src/android_colors.rs); this default is what desktop and older
    // Android show instead.
    in-out property <color> dynamic-accent: #b3261e;

    // Set once at startup on Android only, so the in-app "Start daemon"
    // card only shows up where it's actually needed (desktop runs the
    // daemon as a separate process the usual way).
    in-out property <bool> is-android: false;
    in-out property <string> daemon-status-text: "";

    // Gateway
    in-out property <[InterfaceInfo]> interfaces: [];
    in-out property <[string]> interface-names: [];
    in-out property <bool> dynv6-enabled: false;
    in-out property <string> dynv6-token: "";
    in-out property <string> dynv6-interface: "";
    in-out property <string> dynv6-domains-text: "";
    in-out property <string> dynv6-status-text: "";

    // App Router
    in-out property <[RouteRow]> routes: [];
    in-out property <string> new-subdomain: "";
    in-out property <bool> new-is-static: true;
    in-out property <string> new-path: "";
    in-out property <int> new-port: 8080;
    in-out property <bool> new-tls: false;

    // Security Shield
    in-out property <[L4RuleRow]> l4-rules: [];
    in-out property <string> new-l4-name: "";
    in-out property <bool> new-l4-udp: false;
    in-out property <int> new-l4-listen-port: 25565;
    in-out property <int> new-l4-upstream-port: 25566;
    in-out property <string> blocked-ips-text: "";

    // Post Office
    in-out property <string> mail-domain: "";
    in-out property <[MailAccountRow]> mail-accounts: [];
    in-out property <string> new-mail-address: "";
    in-out property <string> new-mail-display-name: "";

    callback refresh-interfaces();
    callback save-dynv6();
    callback sync-dynv6-now();
    callback add-route();
    callback delete-route(string);
    callback apply();
    callback save-security();
    callback add-l4-rule();
    callback delete-l4-rule(string);
    callback save-mail();
    callback add-mail-account();
    callback delete-mail-account(string);
    callback start-daemon();
}

component Card inherits Rectangle {
    background: #211e28;
    border-radius: 16px;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        @children
    }
}

component SectionLabel inherits Text {
    font-size: 13px;
    font-weight: 700;
    color: #b8b2c4;
}

component EmptyHint inherits Text {
    font-size: 12px;
    color: #77718a;
}

component ItemCard inherits Rectangle {
    background: #2a2632;
    border-radius: 12px;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        @children
    }
}

component ItemTitle inherits Text {
    font-size: 15px;
    font-weight: 700;
    color: white;
}

component ItemDetail inherits Text {
    font-size: 12px;
    color: #9c96a8;
    wrap: word-wrap;
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    border-radius: 14px;
    background: root.selected ? #3a3450 : transparent;

    TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 2px;
        alignment: center;
        Text {
            text: root.icon;
            font-size: 20px;
            horizontal-alignment: center;
            color: root.selected ? AppState.dynamic-accent : #9c96a8;
        }
        Text {
            text: root.label;
            font-size: 11px;
            horizontal-alignment: center;
            color: root.selected ? white : #9c96a8;
        }
    }
}

component GatewayPage inherits VerticalLayout {
    spacing: 16px;

    Card {
        SectionLabel { text: "Dynamic DNS"; }
        HorizontalLayout {
            spacing: 8px;
            CheckBox { text: "Enable sync"; checked <=> AppState.dynv6-enabled; }
            Button { text: "Refresh"; clicked => { AppState.refresh-interfaces(); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Interface"; vertical-alignment: center; color: #cfc9da; }
            ComboBox {
                model: AppState.interface-names;
                current-value <=> AppState.dynv6-interface;
            }
        }
        LineEdit { placeholder-text: "dynv6 token"; text <=> AppState.dynv6-token; }
        LineEdit { placeholder-text: "domains, comma separated"; text <=> AppState.dynv6-domains-text; }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Save"; clicked => { AppState.save-dynv6(); } }
            Button { text: "Sync now"; clicked => { AppState.sync-dynv6-now(); } }
        }
        ItemDetail { text: AppState.dynv6-status-text; }
    }

    if AppState.is-android: Card {
        SectionLabel { text: "Daemon"; }
        ItemDetail { text: AppState.daemon-status-text; }
        Button { text: "Start daemon"; clicked => { AppState.start-daemon(); } }
    }

    Card {
        SectionLabel { text: "Detected interfaces"; }
        if AppState.interfaces.length == 0: EmptyHint { text: "No interfaces detected yet."; }
        for iface in AppState.interfaces: ItemCard {
            ItemTitle { text: iface.name; }
            ItemDetail { text: "MAC " + iface.mac; }
            ItemDetail { text: "IPv4 " + iface.ipv4; }
            ItemDetail { text: "IPv6 " + iface.ipv6; }
        }
    }
}

component RouterPage inherits VerticalLayout {
    spacing: 16px;

    Card {
        SectionLabel { text: "New route"; }
        LineEdit { placeholder-text: "subdomain, e.g. cloud.example.com"; text <=> AppState.new-subdomain; }
        HorizontalLayout {
            spacing: 8px;
            CheckBox { text: "Static folder"; checked <=> AppState.new-is-static; }
            CheckBox { text: "TLS"; checked <=> AppState.new-tls; }
        }
        LineEdit { placeholder-text: "folder path"; text <=> AppState.new-path; enabled: AppState.new-is-static; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Local port"; vertical-alignment: center; color: #cfc9da; }
            SpinBox { value <=> AppState.new-port; minimum: 1; maximum: 65535; enabled: !AppState.new-is-static; }
        }
        Button { text: "Add route"; clicked => { AppState.add-route(); } }
    }

    Card {
        SectionLabel { text: "Routes"; }
        if AppState.routes.length == 0: EmptyHint { text: "No routes yet."; }
        for r in AppState.routes: ItemCard {
            HorizontalLayout {
                ItemTitle { text: r.subdomain; horizontal-stretch: 1; }
                if r.tls: Text { text: "TLS"; color: AppState.dynamic-accent; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            }
            ItemDetail { text: r.is-static ? "Static: " + r.path : "Port " + r.port; }
            Button { text: "Delete"; clicked => { AppState.delete-route(r.id); } }
        }
    }

    Button { text: "Apply changes"; clicked => { AppState.apply(); } }
}

component SecurityPage inherits VerticalLayout {
    spacing: 16px;

    Card {
        SectionLabel { text: "New raw TCP/UDP rule"; }
        LineEdit { placeholder-text: "name, e.g. minecraft"; text <=> AppState.new-l4-name; }
        CheckBox { text: "UDP (unchecked = TCP)"; checked <=> AppState.new-l4-udp; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Listen port"; vertical-alignment: center; color: #cfc9da; }
            SpinBox { value <=> AppState.new-l4-listen-port; minimum: 1; maximum: 65535; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Upstream port"; vertical-alignment: center; color: #cfc9da; }
            SpinBox { value <=> AppState.new-l4-upstream-port; minimum: 1; maximum: 65535; }
        }
        Button { text: "Add rule"; clicked => { AppState.add-l4-rule(); } }
    }

    Card {
        SectionLabel { text: "Rules"; }
        if AppState.l4-rules.length == 0: EmptyHint { text: "No rules yet."; }
        for rule in AppState.l4-rules: ItemCard {
            ItemTitle { text: rule.name; }
            ItemDetail { text: (rule.is-udp ? "UDP " : "TCP ") + rule.listen-port + " -> " + rule.upstream-port; }
            Button { text: "Delete"; clicked => { AppState.delete-l4-rule(rule.id); } }
        }
    }

    Card {
        SectionLabel { text: "Blocked IPs"; }
        LineEdit { placeholder-text: "comma separated"; text <=> AppState.blocked-ips-text; }
    }

    Button { text: "Save security config"; clicked => { AppState.save-security(); } }
}

component MailPage inherits VerticalLayout {
    spacing: 16px;

    Card {
        SectionLabel { text: "Mail domain"; }
        LineEdit { placeholder-text: "mail domain"; text <=> AppState.mail-domain; }
    }

    Card {
        SectionLabel { text: "New account"; }
        LineEdit { placeholder-text: "address"; text <=> AppState.new-mail-address; }
        LineEdit { placeholder-text: "display name"; text <=> AppState.new-mail-display-name; }
        Button { text: "Add account"; clicked => { AppState.add-mail-account(); } }
    }

    Card {
        SectionLabel { text: "Accounts"; }
        if AppState.mail-accounts.length == 0: EmptyHint { text: "No accounts yet."; }
        for acct in AppState.mail-accounts: ItemCard {
            ItemTitle { text: acct.address; }
            ItemDetail { text: acct.display-name; }
            Button { text: "Delete"; clicked => { AppState.delete-mail-account(acct.address); } }
        }
    }

    Button { text: "Save mail config"; clicked => { AppState.save-mail(); } }
}

export component MainWindow inherits Window {
    title: "PocketServer";
    preferred-width: 900px;
    preferred-height: 700px;
    background: #15131a;

    in-out property <int> current-page: 0;

    // Driven by AppState.is-android (set once from Rust at startup) rather
    // than root.width: window width in Slint is itself partly derived from
    // content layout, so branching the whole layout shape on it created a
    // real binding loop (root.compact -> layoutinfo-h -> root.width ->
    // root.compact) that the compiler flagged as a runtime panic risk, not
    // just a style nit. This also matches the actual bug report more
    // directly -- Android should always get the compact/mobile layout,
    // not just when its window happens to be narrow.
    property <bool> compact: AppState.is-android;

    VerticalLayout {
        Rectangle {
            height: 4px;
            background: AppState.dynamic-accent;
        }

        if root.compact: VerticalLayout {
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;
                    if AppState.status-line != "": ItemDetail { text: AppState.status-line; color: #e08a8a; }
                    if root.current-page == 0: GatewayPage {}
                    if root.current-page == 1: RouterPage {}
                    if root.current-page == 2: SecurityPage {}
                    if root.current-page == 3: MailPage {}
                }
            }
            Rectangle {
                height: 68px;
                background: #1c1924;
                HorizontalLayout {
                    padding: 6px;
                    spacing: 4px;
                    NavItem { icon: "🌐"; label: "Gateway"; selected: root.current-page == 0; clicked => { root.current-page = 0; } }
                    NavItem { icon: "🔀"; label: "Router"; selected: root.current-page == 1; clicked => { root.current-page = 1; } }
                    NavItem { icon: "🛡"; label: "Security"; selected: root.current-page == 2; clicked => { root.current-page = 2; } }
                    NavItem { icon: "✉"; label: "Mail"; selected: root.current-page == 3; clicked => { root.current-page = 3; } }
                }
            }
        }

        if !root.compact: HorizontalLayout {
            Rectangle {
                width: 110px;
                background: #1c1924;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: start;
                    NavItem { icon: "🌐"; label: "Gateway"; selected: root.current-page == 0; clicked => { root.current-page = 0; } }
                    NavItem { icon: "🔀"; label: "Router"; selected: root.current-page == 1; clicked => { root.current-page = 1; } }
                    NavItem { icon: "🛡"; label: "Security"; selected: root.current-page == 2; clicked => { root.current-page = 2; } }
                    NavItem { icon: "✉"; label: "Mail"; selected: root.current-page == 3; clicked => { root.current-page = 3; } }
                }
            }
            ScrollView {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    if AppState.status-line != "": ItemDetail { text: AppState.status-line; color: #e08a8a; }
                    if root.current-page == 0: GatewayPage {}
                    if root.current-page == 1: RouterPage {}
                    if root.current-page == 2: SecurityPage {}
                    if root.current-page == 3: MailPage {}
                }
            }
        }
    }
}
